# =========================
# FRONTEND
# =========================

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.vercel/

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Keep example env
!frontend/.env.example

# TypeScript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Package manager
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions


# =========================
# BACKEND
# =========================

backend/node_modules/
backend/coverage/
backend/build/
backend/dist/

# Backend environment files
backend/.env
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local

# Keep example env
!backend/.env.example

# TypeScript
backend/*.tsbuildinfo

# Package manager
backend/.pnp
backend/.pnp.*
backend/.yarn/*
!backend/.yarn/patches
!backend/.yarn/plugins
!backend/.yarn/releases
!backend/.yarn/versions


# =========================
# GENERAL
# =========================

.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*